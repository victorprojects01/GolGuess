# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Vercel: connect Neon/Postgres and set the pooled connection string.
# Keep credentials in Vercel Settings > Environment Variables, never in Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Recomendado no modo sem banco. Gere uma sequência aleatória com pelo menos 32 bytes.
GOLGUESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
# Local development can omit DATABASE_URL and uses SQLite automatically.


# Keep off until a certified CMP is integrated and Auto ads positions are reviewed.
GOLGUESS_ADS_ENABLED=0
# IAB CMP ID of the installed Google-certified CMP (not the AdSense publisher ID).
GOLGUESS_CMP_ID=
