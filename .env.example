# Vercel: connect Neon/Postgres and set the pooled connection string.
# Keep credentials in Vercel Settings > Environment Variables, never in Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Recomendado no modo sem banco. Gere uma sequência aleatória com pelo menos 32 bytes.
GOLGUESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
# Local development can omit DATABASE_URL and uses SQLite automatically.
